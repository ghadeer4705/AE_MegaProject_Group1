    {
      "cell_type": "code",
      "source": [
        "import os\n",
        "import random\n",
        "import cv2\n",
        "from google.colab.patches import cv2_imshow\n",
        "from ultralytics import YOLO\n",
        "\n",
        "model = YOLO('/content/drive/MyDrive/best.pt')\n",
        "\n",
        "ALTITUDE_M = 80.0\n",
        "FOCAL_LENGTH_MM = 21.0\n",
        "SENSOR_W_MM = 7.6\n",
        "SENSOR_H_MM = 5.7\n",
        "\n",
        "folder_path = '/content/drive/MyDrive/test'\n",
        "\n",
        "valid_extensions = ('.jpg', '.jpeg', '.png', '.bmp', '.webp')\n",
        "images = [\n",
        "    f\n",
        "    for f in os.listdir(folder_path)\n",
        "    if f.lower().endswith(valid_extensions)\n",
        "    and os.path.isfile(os.path.join(folder_path, f))\n",
        "]\n",
        "\n",
        "if not images:\n",
        "    print('No images found in /content')\n",
        "else:\n",
        "    random_image = random.choice(images)\n",
        "    image_path = os.path.join(folder_path, random_image)\n",
        "    print(f'Selected image: {random_image}')\n",
        "\n",
        "    results = model.predict(source=image_path, conf=0.1, save=False)\n",
        "\n",
        "    boxes = results[0].boxes\n",
        "    names = results[0].names\n",
        "\n",
        "    orig_img = results[0].orig_img\n",
        "    img_h, img_w = orig_img.shape[:2]\n",
        "\n",
        "    center_img_x = img_w / 2.0\n",
        "    center_img_y = img_h / 2.0\n",
        "\n",
        "    gsd_x = (ALTITUDE_M * SENSOR_W_MM) / (FOCAL_LENGTH_MM * img_w)\n",
        "    gsd_y = (ALTITUDE_M * SENSOR_H_MM) / (FOCAL_LENGTH_MM * img_h)\n",
        "\n",
        "    res_plotted = results[0].plot()\n",
        "\n",
        "    if len(boxes) == 0:\n",
        "        print('No objects detected.')\n",
        "    else:\n",
        "        xywh_list = boxes.xywh.cpu().numpy()\n",
        "        xyxy_list = boxes.xyxy.cpu().numpy()\n",
        "\n",
        "        for i, box in enumerate(boxes):\n",
        "            cls_id = int(box.cls[0].item())\n",
        "            class_name = names[cls_id]\n",
        "            confidence = float(box.conf[0].item())\n",
        "\n",
        "            cx_pix, cy_pix, w_pix, h_pix = xywh_list[i]\n",
        "            x1, y1, x2, y2 = xyxy_list[i]\n",
        "\n",
        "            dx_pix = cx_pix - center_img_x\n",
        "            dy_pix = center_img_y - cy_pix\n",
        "\n",
        "            x_meters = dx_pix * gsd_x\n",
        "            y_meters = dy_pix * gsd_y\n",
        "\n",
        "            print(f'Detected: {class_name} | Confidence: {confidence:.2f}')\n",
        "            print(f'Pixel Center: (x: {cx_pix:.1f} px, y: {cy_pix:.1f} px)')\n",
        "            print(f'Coordinates: X = {x_meters:+.2f} m, Y = {y_meters:+.2f} m')\n",
        "\n",
        "            label_coord = f'X:{x_meters:+.2f}m, Y:{y_meters:+.2f}m'\n",
        "            pt_center = (int(cx_pix), int(cy_pix))\n",
        "            cv2.circle(res_plotted, pt_center, 3, (0, 0, 255), -1)\n",
        "\n",
        "            text_x = max(5, int(x1))\n",
        "            text_y = min(img_h - 10, int(y2) + 20)\n",
        "\n",
        "            (text_w, text_h), baseline = cv2.getTextSize(\n",
        "                label_coord, cv2.FONT_HERSHEY_SIMPLEX, 0.45, 1\n",
        "            )\n",
        "            cv2.rectangle(\n",
        "                res_plotted,\n",
        "                (text_x - 2, text_y - text_h - 2),\n",
        "                (text_x + text_w + 2, text_y + baseline),\n",
        "                (0, 0, 0),\n",
        "                -1,\n",
        "            )\n",
        "            cv2.putText(\n",
        "                res_plotted,\n",
        "                label_coord,\n",
        "                (text_x, text_y),\n",
        "                cv2.FONT_HERSHEY_SIMPLEX,\n",
        "                0.45,\n",
        "                (0, 255, 255),\n",
        "                1,\n",
        "                cv2.LINE_AA,\n",
        "            )\n",
        "\n",
        "    cv2_imshow(res_plotted)"
      ],
